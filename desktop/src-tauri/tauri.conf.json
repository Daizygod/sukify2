{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sukify Desktop",
  "version": "0.1.0",
  "identifier": "app.sukify.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sukify Desktop",
        "width": 440,
        "height": 600,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Статус Sukify в Discord",
    "longDescription": "Показывает в статусе Discord трек, который играет в Sukify: обложка, исполнитель и полоса прогресса."
  }
}
