<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Экран запуска (Android 12+): тёмный фон и зелёная «S», как у веба. -->
    <style name="Theme.Sukify.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sukify_elevated</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Sukify</item>
    </style>

    <style name="Theme.Sukify" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sukify_elevated</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
