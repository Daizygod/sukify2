<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Музыка в фоне: сервис воспроизведения в foreground и не засыпающая сеть. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Загрузки треков: WorkManager качает в foreground (dataSync), чтобы система не убила. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Автообновление: приложение ставит свою свежую сборку поверх себя (с подтверждением). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".SukifyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sukify.Starting"
        tools:targetApi="36">

        <!-- Поворот и смена размера обрабатываются Compose без пересоздания
             активности — иначе редактор переходов дёргался бы при повороте. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Ссылки на сайт открываются в приложении: «Поделиться» в вебе и приглашения
                 в совместный плейлист. autoVerify — по assetlinks.json с отпечатком ключа подписи. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="sukify.nepalimsya.ru" />
                <data android:pathPrefix="/release/" />
                <data android:pathPrefix="/artist/" />
                <data android:pathPrefix="/playlist/" />
                <data android:pathPrefix="/user/" />
                <data android:pathPrefix="/mix/" />
                <data android:pathPrefix="/genre/" />
                <data android:path="/link-device" />
                <data android:path="/liked" />
            </intent-filter>
        </activity>

        <!-- Воспроизведение: MediaSession для уведомления, экрана блокировки,
             гарнитуры и Android Auto (MediaBrowserService — для старых клиентов). -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- ▶ с гарнитуры или руля, когда приложение не запущено: Media3 поднимает
             сервис и продолжает прошлую сессию (onPlaybackResumption). -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Обложки для Android Auto: машине нужен content://, а не ссылка в сеть.
             Отдаёт только картинки обложек (проверка адреса в CoverProvider). -->
        <provider
            android:name=".playback.auto.CoverProvider"
            android:authorities="${applicationId}.covers"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Android Auto: приложение — медиаплеер. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@drawable/ic_notification" />

        <!-- Загрузчик треков работает как foreground-сервис WorkManager с типом dataSync. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Виджет плеера на рабочем столе (Glance). -->
        <receiver
            android:name=".widget.SukifyWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sukify_widget_info" />
        </receiver>

        <!-- Итог установки обновления от PackageInstaller. -->
        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />

        <!-- WorkManager настраиваем сами (воркеры с Hilt). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
